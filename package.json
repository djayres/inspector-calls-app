{
  "name": "inspector-calls-app",
  "version": "1.0.0",
  "private": true,
  "description": "An Inspector Calls for Windows: greets the inspector and opens the An Inspector Calls workspace with their Claude login",
  "author": "djayres",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis --publish never"
  },
  "devDependencies": {
    "electron": "33.2.1",
    "electron-builder": "25.1.8"
  },
  "build": {
    "appId": "com.djayres.inspectorcalls",
    "productName": "An Inspector Calls",
    "files": ["main.js", "preload.js", "app/**", "resources/icon.png"],
    "directories": { "buildResources": "resources", "output": "dist" },
    "win": { "target": "nsis", "icon": "resources/icon.ico" },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "artifactName": "Inspector-Calls-Setup.exe",
      "shortcutName": "An Inspector Calls",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "resources/icon.ico",
      "uninstallerIcon": "resources/icon.ico"
    }
  }
}
